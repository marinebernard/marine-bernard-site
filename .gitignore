# Journaux serveur (sensibles, ne pas versionner)
logs/

# Anciens fichiers hérités, sans rapport avec le site actuel
homza.html
homza-site.html
.thumbnail

# Fichiers système
Thumbs.db
.DS_Store

# Config locale Claude
.claude/

# Identifiants base de données — jamais dans Git, uploadé à la main sur le serveur
api/config.php

# Mot de passe admin du back office — même logique que api/config.php
admin/config.php

# Contenu envoyé par le back office (photos/GPX) — jamais versionné, vit uniquement sur le serveur
uploads/parcours/*
!uploads/parcours/.htaccess

# Cartes de partage générées à la volée par admin/generate-card.php
uploads/cartes/*
!uploads/cartes/.htaccess

# Polices téléchargées à la demande par admin/fonts/download-fonts.php
admin/fonts/*.ttf

# Photos d'articles envoyées par admin/article-form.php — jamais versionnées
uploads/articles/*
!uploads/articles/.htaccess

# Photos de projets envoyées par admin/projet-form.php — jamais versionnées
uploads/projets/*
!uploads/projets/.htaccess

# Photos de la galerie pro envoyées par admin/galerie-pro.php — jamais versionnées
uploads/galerie-pro/*
!uploads/galerie-pro/.htaccess
